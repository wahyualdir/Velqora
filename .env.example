# ==============================================================================
# Velqora Environment Configuration Template
# ==============================================================================
# Salin file ini menjadi .env.local dan isi dengan credentials asli Anda.
# PENTING: Jangan pernah melakukan commit file .env.local ke dalam Git!
# ==============================================================================

# --- 1. Supabase Credentials (Wajib untuk Autentikasi & Database) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- 2. Multimodal AI Providers (Wajib untuk AI Tutor, Quiz Generator & AI Parsing) ---
# Gemini API Key dari Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API Key (Opsional - fallback untuk AI Engine)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- 3. Application Domain & URLs (Opsional - default: https://velqora.app) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 4. Role & Administrative Emails (Opsional) ---
NEXT_PUBLIC_OWNER_EMAIL=admin@velqora.app
NEXT_PUBLIC_ADMIN_EMAIL=admin@velqora.app

# --- 5. Vision / OCR Services (Opsional - fallback OCR eksternal) ---
OCR_API_KEY=your_ocr_api_key_here
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
